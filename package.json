{
  "name": "dhaka-traffic-prediction",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite frontend",
    "server": "node server/index.js",
    "dev:all": "concurrently -n \"API,VITE\" -c \"blue,green\" \"npm run server\" \"npm run dev\"",
