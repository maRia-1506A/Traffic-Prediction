# ========================================================
# Traffic Prediction API Configuration
# ========================================================

# TomTom Routing & Traffic API Key (Used for real-time travel duration and traffic delays)
# Sign up and get your free API key at: https://developer.tomtom.com/
TOMTOM_API_KEY=your_tomtom_api_key_here

# OpenWeatherMap API Key (Used for live temperature, rainfall, and atmospheric conditions)
# Sign up and get your free API key at: https://openweathermap.org/api
OPENWEATHERMAP_API_KEY=your_openweathermap_api_key_here
